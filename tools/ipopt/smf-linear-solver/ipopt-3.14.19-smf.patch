+
+#define SMF_SCALE_NONE           0
+#define SMF_SCALE_MATCHING       1
+#define SMF_SCALE_EQUILIBRATION  2
+#define SMF_SCALE_AUTO           3
+
+#define SMF_SLACK_OFF            0
+#define SMF_SLACK_ON             1
